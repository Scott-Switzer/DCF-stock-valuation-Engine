{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/relative-financials-v1",
  "title": "CUIG relative financials v1",
  "type": "object",
  "required": [
    "schema_version",
    "units",
    "valuation_date",
    "company",
    "market",
    "bridge",
    "source",
    "target",
    "comparables"
  ],
  "properties": {
    "schema_version": {
      "const": "relative-financials-v1"
    },
    "units": {
      "const": "absolute"
    },
    "valuation_date": {
      "type": "string",
      "format": "date"
    },
    "company": {
      "type": "object",
      "required": [
        "ticker",
        "name",
        "currency",
        "eligible"
      ],
      "properties": {
        "ticker": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "currency": {
          "const": "USD"
        },
        "eligible": {
          "const": true
        },
        "sector": {
          "type": "string"
        },
        "is_financial": {
          "type": "boolean"
        }
      }
    },
    "market": {
      "type": "object",
      "required": [
        "price",
        "price_as_of",
        "currency",
        "diluted_shares",
        "shares_basis"
      ],
      "properties": {
        "price": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "diluted_shares": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "price_as_of": {
          "type": "string",
          "format": "date"
        },
        "currency": {
          "const": "USD"
        },
        "shares_basis": {
          "type": "string"
        }
      }
    },
    "bridge": {
      "type": "object",
      "required": [
        "short_term_debt",
        "long_term_debt",
        "cash",
        "preferred_equity",
        "minority_interest",
        "other_nonoperating_assets",
        "as_of"
      ],
      "properties": {
        "short_term_debt": {
          "type": "number",
          "minimum": 0
        },
        "long_term_debt": {
          "type": "number",
          "minimum": 0
        },
        "cash": {
          "type": "number",
          "minimum": 0
        },
        "preferred_equity": {
          "type": "number",
          "minimum": 0
        },
        "minority_interest": {
          "type": "number",
          "minimum": 0
        },
        "other_nonoperating_assets": {
          "type": "number",
          "minimum": 0
        },
        "as_of": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "synthetic",
            "manual",
            "sec",
            "zion",
            "api"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "available_at": {
          "type": "string",
          "description": "Information availability date or timestamp; must not follow valuation_date."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "sec",
                  "zion",
                  "api"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "available_at"
            ]
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "historical_as_of",
        "historical",
        "forward"
      ],
      "properties": {
        "historical_as_of": {
          "type": "string",
          "format": "date"
        },
        "historical": {
          "type": "object",
          "properties": {
            "revenue": {
              "type": [
                "number",
                "null"
              ]
            },
            "ebitda": {
              "type": [
                "number",
                "null"
              ]
            },
            "ebit": {
              "type": [
                "number",
                "null"
              ]
            },
            "net_income": {
              "type": [
                "number",
                "null"
              ]
            },
            "book_value": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "forward": {
          "type": "object",
          "properties": {
            "revenue": {
              "type": [
                "number",
                "null"
              ]
            },
            "ebitda": {
              "type": [
                "number",
                "null"
              ]
            },
            "ebit": {
              "type": [
                "number",
                "null"
              ]
            },
            "net_income": {
              "type": [
                "number",
                "null"
              ]
            },
            "book_value": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      }
    },
    "comparables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "ticker",
          "as_of",
          "currency",
          "source",
          "multiples"
        ],
        "properties": {
          "ticker": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "as_of": {
            "type": "string",
            "format": "date"
          },
          "currency": {
            "const": "USD"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "multiples": {
            "type": "object",
            "properties": {
              "ev_revenue": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "ev_ebitda": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "ev_ebit": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "pe": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "pb": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$comment": "Runtime additionally checks method suitability, finite numbers, dates, selected forward denominators and duplicate peers."
}
