# Optional. Set environment variables in your shell or deployment dashboard.
# Never commit a populated .env file. app.py does not automatically load it.
EDGAR_IDENTITY=
ZION_API_BASE_URL=
ZION_API_TOKEN=
DCF_API_BASE_URL=
DCF_API_TOKEN=
DCF_STATE_PATH=/tmp/dcf-state.sqlite3
TRUSTED_PROXY_HOPS=0
PORT=5000
# Signs the lib_id library cookie. Set a long random value in production
# (wrangler secret put LIBRARY_SECRET); dev fallback is insecure.
LIBRARY_SECRET=
