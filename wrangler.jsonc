{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dcf-valuation-engine",
  "main": "worker_runtime/worker.py",
  "account_id": "51b88c6a6ef833b3c2ff46e98d5d9356",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": true,
  "ratelimits": [
    {"name": "PREVIEW_LIMIT", "namespace_id": "1946100601", "simple": {"limit": 120, "period": 60}},
    {"name": "REFERENCE_LIMIT", "namespace_id": "1946100602", "simple": {"limit": 20, "period": 60}},
    {"name": "WRITE_LIMIT", "namespace_id": "1946100603", "simple": {"limit": 10, "period": 60}},
    {"name": "MCP_LIMIT", "namespace_id": "1946100604", "simple": {"limit": 60, "period": 60}}
  ],
  // Production environment. ZION_FINANCIAL_QUERY is deliberately absent: every Zion
  // financial-data Worker in this account is a staging deployment, so binding it here
  // would make a production release depend on a staging data plane. The equity-claims
  // route returns 503 without a binding. Add the binding only when a production Zion
  // thin Worker exists -- see the staging block below for the arming that is intended.
  "services": [
    {"binding": "ZION_VALUATIONS", "service": "zion-valuation"},
    {"binding": "ZION_DATASET_CATALOG", "service": "zion-datasets", "entrypoint": "Catalog"}
  ],
  "r2_buckets": [{"binding": "PPE_DATA", "bucket_name": "financial-system-datasets"}],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dcf-valuations",
      "database_id": "77b1393e-ef20-4081-9dd7-4a7ab787c933",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "EDGAR_IDENTITY": "Scott Switzer scswitzer@chapman.edu"
  },
  "build": {
    "command": "python3 scripts/embed_assets.py"
  },
  "preview_urls": false,
  "env": {
    "staging": {
      "name": "dcf-valuation-engine-staging",
      "main": "worker_runtime/worker.py",
      "account_id": "51b88c6a6ef833b3c2ff46e98d5d9356",
      "compatibility_date": "2026-10-06",
      "compatibility_flags": ["python_workers"],
      "workers_dev": true,
      "ratelimits": [
        {"name": "PREVIEW_LIMIT", "namespace_id": "1946200601", "simple": {"limit": 120, "period": 60}},
        {"name": "REFERENCE_LIMIT", "namespace_id": "1946200602", "simple": {"limit": 20, "period": 60}},
        {"name": "WRITE_LIMIT", "namespace_id": "1946200603", "simple": {"limit": 10, "period": 60}},
        {"name": "MCP_LIMIT", "namespace_id": "1946200604", "simple": {"limit": 60, "period": 60}}
      ],
      // The only scoped internal dependency on the Zion equity-claims route. It reaches
      // the staging thin Worker over a Cloudflare service binding, so no public hostname,
      // no bearer credential and no egress leave this account.
      "services": [
        {"binding": "ZION_VALUATIONS", "service": "zion-valuation"},
        {"binding": "ZION_DATASET_CATALOG", "service": "zion-datasets", "entrypoint": "Catalog"},
        {"binding": "ZION_FINANCIAL_QUERY", "service": "zion-financial-serving-v2-thin-staging"}
      ],
      "r2_buckets": [{"binding": "PPE_DATA", "bucket_name": "financial-system-datasets"}],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dcf-valuations-staging",
          "database_id": "cb4e6d0f-a800-4cdd-a4c4-7849c9617e07",
          "migrations_dir": "migrations"
        }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      },
      "cache": {
        "enabled": true
      },
      "vars": {
        "EDGAR_IDENTITY": "Scott Switzer scswitzer@chapman.edu",
        "DEPLOY_ENVIRONMENT": "staging",
        "PPE_POINTER_OVERRIDE": "control/valuation/CANDIDATE-staging.json",
        "ZION_EQUITY_CLAIMS_CALLER": "dcf-valuation-engine",
        // Benchmark assumptions are a separate Zion dependency from the equity-claims route:
        // they resolve over HTTPS against the staging DDFI benchmark Worker, which authenticates
        // with the same staging private bearer the history leg uses. The credential itself is a
        // Worker secret (ZION_BENCHMARK_TOKEN); only the origin is configuration.
        "ZION_BENCHMARK_BASE_URL": "https://zion-ddfi-benchmark-staging.scswitzer.workers.dev"
      },
      "build": {
        "command": "python3 scripts/embed_assets.py"
      },
      "preview_urls": false
    }
  }
}
